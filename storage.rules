rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function journeyMember(journeyId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/journeys/$(journeyId)/members/$(request.auth.uid)
        );
    }

    function canEditJourney(journeyId) {
      return journeyMember(journeyId)
        && firestore.get(
          /databases/(default)/documents/journeys/$(journeyId)/members/$(request.auth.uid)
        ).data.role in ['owner', 'editor'];
    }

    function validImageUpload() {
      return request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    match /journeys/{journeyId}/anchor/{fileName} {
      allow read: if journeyMember(journeyId);

      allow create, update: if canEditJourney(journeyId)
        && validImageUpload();

      allow delete: if canEditJourney(journeyId);
    }

    match /journeys/{journeyId}/entries/{entryId}/{userId}/{fileName} {
      allow read: if journeyMember(journeyId);

      allow create, update: if canEditJourney(journeyId)
        && request.auth.uid == userId
        && validImageUpload();

      allow delete: if canEditJourney(journeyId)
        && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
