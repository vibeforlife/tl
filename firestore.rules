rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function journeyMember(journeyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/journeys/$(journeyId)/members/$(request.auth.uid));
    }

    function journeyRole(journeyId) {
      return get(/databases/$(database)/documents/journeys/$(journeyId)/members/$(request.auth.uid)).data.role;
    }

    function canReadJourney(journeyId) {
      return journeyMember(journeyId);
    }

    function canEditJourney(journeyId) {
      return journeyMember(journeyId)
        && journeyRole(journeyId) in ['owner', 'editor'];
    }

    function validEntryLocation(data) {
      return !('location' in data)
        || data.location == null
        || (
          data.location is map
          && data.location.keys().hasOnly([
            'name', 'address', 'latitude', 'longitude', 'mapboxPlaceId',
            'countryName', 'countryCode', 'countrySource'
          ])
          && data.location.name is string
          && data.location.latitude is number
          && data.location.longitude is number
          && data.location.latitude >= -90
          && data.location.latitude <= 90
          && data.location.longitude >= -180
          && data.location.longitude <= 180
          && (
            (
              !('countryName' in data.location)
              && !('countryCode' in data.location)
              && !('countrySource' in data.location)
            )
            || (
              'countryName' in data.location
              && 'countryCode' in data.location
              && 'countrySource' in data.location
              && data.location.countryName is string
              && data.location.countryName.size() > 0
              && data.location.countryCode is string
              && data.location.countryCode.matches('[A-Z]{2}')
              && data.location.countrySource == 'mapbox-search-box'
            )
          )
        );
    }

    function validEntryManualCountry(data) {
      return !('manualCountry' in data)
        || data.manualCountry == null
        || (
          data.manualCountry is map
          && data.manualCountry.keys().hasOnly([
            'countryCode', 'countryName', 'source', 'assignedBy', 'assignedAt'
          ])
          && data.manualCountry.countryCode is string
          && data.manualCountry.countryCode.matches('[A-Z]{2}')
          && data.manualCountry.countryName is string
          && data.manualCountry.countryName.size() > 0
          && data.manualCountry.source == 'manual'
          && data.manualCountry.assignedBy is string
          && data.manualCountry.assignedBy.size() > 0
          && data.manualCountry.assignedAt is timestamp
        );
    }

    // Memory associations use stable People profile references only.
    // The list is bounded and stores {personId, ownerId, displayName}.
    function validEntryPeopleRefs(data) {
      return !('peopleRefs' in data)
        || (
          data.peopleRefs is list
          && data.peopleRefs.size() <= 100
        );
    }

    function validEntryGeography(data) {
      return !('geography' in data)
        || data.geography == null
        || (
          data.geography is map
          && data.geography.keys().hasOnly([
            'countryCode', 'countryName', 'status', 'sourceLatitude',
            'sourceLongitude', 'datasetVersion', 'algorithmVersion'
          ])
          && data.geography.status in ['matched', 'ambiguous', 'near-boundary', 'unmatched']
          && data.geography.sourceLatitude is number
          && data.geography.sourceLongitude is number
          && data.geography.sourceLatitude >= -90
          && data.geography.sourceLatitude <= 90
          && data.geography.sourceLongitude >= -180
          && data.geography.sourceLongitude <= 180
          && data.geography.datasetVersion is string
          && data.geography.algorithmVersion is string
          && (
            data.geography.status != 'matched'
            || (
              data.geography.countryCode is string
              && data.geography.countryName is string
            )
          )
        );
    }

    function isJourneyOwner(journeyId) {
      return journeyMember(journeyId)
        && journeyRole(journeyId) == 'owner';
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;

      match /people/{personId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.normalizedName is string
          && request.resource.data.aliases is list
          && request.resource.data.keys().hasOnly([
            'ownerId', 'name', 'normalizedName', 'aliases', 'notes', 'createdAt', 'updatedAt'
          ]);
allow update: if signedIn()
          && request.auth.uid == userId
          && resource.data.ownerId == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.keys().hasOnly([
            'ownerId', 'name', 'normalizedName', 'aliases', 'notes', 'createdAt', 'updatedAt'
          ]);
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /journeys/{journeyId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/journeys/$(journeyId)/members/$(userId)).data.role == 'owner';
        allow update: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn()
          && (
            request.auth.uid == userId
            || get(/databases/$(database)/documents/journeys/$(journeyId)).data.createdBy == request.auth.uid
          );
      }
    }

    function validJourneyAnchorPhoto(photo) {
      return photo is map
        && photo.keys().hasOnly(['url', 'storagePath'])
        && photo.url is string
        && photo.storagePath is string;
    }

    function validGooglePhotosUrl(url) {
      return url is string
        && url.matches('https://.*');
    }

    match /journeys/{journeyId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.place is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && (
          !('distanceEndpointMode' in request.resource.data)
          || request.resource.data.distanceEndpointMode == 'explicit'
        )
        && (
          !('anchorPhoto' in request.resource.data)
          || validJourneyAnchorPhoto(request.resource.data.anchorPhoto)
        )
        && (
          !('googlePhotosUrl' in request.resource.data)
          || validGooglePhotosUrl(request.resource.data.googlePhotosUrl)
        );

      allow read: if canReadJourney(journeyId);
      allow update: if canEditJourney(journeyId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'place',
          'startDate',
          'endDate',
          'anchorPhoto',
          'googlePhotosUrl',
          'updatedAt'
        ])
        && (
          !('anchorPhoto' in request.resource.data)
          || validJourneyAnchorPhoto(request.resource.data.anchorPhoto)
        )
        && (
          !('googlePhotosUrl' in request.resource.data)
          || validGooglePhotosUrl(request.resource.data.googlePhotosUrl)
        );
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      match /members/{userId} {
        allow read: if canReadJourney(journeyId);

        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.email is string
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/journeys/$(journeyId)).data.createdBy == request.auth.uid;

        allow update: if isJourneyOwner(journeyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

        allow delete: if signedIn()
          && get(/databases/$(database)/documents/journeys/$(journeyId)).data.createdBy == request.auth.uid;
      }

      match /entries/{entryId} {
        allow read: if canReadJourney(journeyId);

        allow create: if canEditJourney(journeyId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.date is string
          && request.resource.data.story is string
          && request.resource.data.peopleRefs is list
          && request.resource.data.tags is list
          && request.resource.data.costs is list
          && validEntryPeopleRefs(request.resource.data)
          && validEntryGeography(request.resource.data)
          && validEntryLocation(request.resource.data)
          && validEntryManualCountry(request.resource.data)
          && (!('manualCountry' in request.resource.data) || request.resource.data.manualCountry == null || request.resource.data.manualCountry.assignedBy == request.auth.uid)
          && (
            !('photo' in request.resource.data)
            || (
              request.resource.data.photo is map
              && request.resource.data.photo.keys().hasOnly(['url', 'storagePath', 'caption'])
              && request.resource.data.photo.url is string
              && request.resource.data.photo.storagePath is string
              && (
                !('caption' in request.resource.data.photo)
                || request.resource.data.photo.caption is string
              )
            )
          );

        allow update: if canEditJourney(journeyId)
          && request.resource.data.createdBy == resource.data.createdBy
          && validEntryPeopleRefs(request.resource.data)
          && validEntryGeography(request.resource.data)
          && validEntryLocation(request.resource.data)
          && validEntryManualCountry(request.resource.data)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['manualCountry'])
            || (
              request.resource.data.manualCountry.assignedBy == request.auth.uid
              && !(
                'location' in request.resource.data
                && request.resource.data.location is map
                && request.resource.data.location.countrySource == 'mapbox-search-box'
                && request.resource.data.location.countryName is string
                && request.resource.data.location.countryName.size() > 0
                && request.resource.data.location.countryCode is string
                && request.resource.data.location.countryCode.matches('[A-Z]{2}')
              )
            )
          );

        allow delete: if canEditJourney(journeyId);
      }
    }

    match /invitations/{invitationId} {
      // V1 sharing links are created only by the Journey owner.
      // Redemption/read access will be added separately when we build
      // the recipient flow.
      allow read: if false;

      allow create: if signedIn()
        && request.resource.data.journeyId is string
        && request.resource.data.inviterId == request.auth.uid
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.createdAt is timestamp
        && isJourneyOwner(request.resource.data.journeyId)
        && request.resource.data.keys().hasOnly([
          'journeyId',
          'inviterId',
          'role',
          'createdAt'
        ]);

      allow update, delete: if false;
    }
  }
}
